# Copy to .env (gitignored). Production values live in Vercel → Settings →
# Environment Variables; nothing here is a real credential.

# Neon Postgres (Frankfurt) — pooled connection string
DATABASE_URL=
# Payload
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.mfmsport.ma

# API-Football (matches, standings, fixtures)
API_FOOTBALL_KEY=

# YouTube Data API v3 — homepage / videos sync (lib/youtube-sync.ts, run by the
# /api/cron/sync-videos cron every 3 h). Restrict the key to the YouTube Data
# API in Google Cloud. Without it the cron 500s and the videos never refresh.
YOUTUBE_API_KEY=

# Vercel Cron authorisation for /api/cron/*
CRON_SECRET=

# Upstash Redis (optional — API-Football response cache + newsletter rate limit).
# NOTE (22 September 2026): the project's Upstash database was ARCHIVED by
# Upstash for inactivity, and Vercel injects it under KV_REST_API_* rather than
# these names, so the cache and the rate limiter have had no store to reach.
# The match-page poll deliberately uses Postgres instead. See CLAUDE.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (media uploads)
BLOB_READ_WRITE_TOKEN=
STORAGE_VERCEL_BLOB_BASE_URL=

# /api/revalidate shared secret
REVALIDATION_SECRET=

# Resend (newsletter)
RESEND_API_KEY=

# Analytics / ads (public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
