{
  "name": "mfm-sport",
  "version": "1.0.0",
  "description": "MFM Sport - Arabic football news portal",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "migrate:wp": "tsx scripts/migrate-wp.ts",
    "migrate:wp:sample": "tsx scripts/migrate-wp.ts --dry-run --limit=10",
    "sync:videos": "tsx scripts/sync-videos.ts",
    "sync:videos:dry": "tsx scripts/sync-videos.ts --dry-run",
    "seed": "tsx scripts/seed.ts",
    "seed:preview": "tsx scripts/seed-preview.ts",
    "seed:preview:reset": "tsx scripts/seed-preview.ts --reset",
    "regen:favicons": "tsx scripts/regen-favicons.ts",
    "build:ar-dicts": "tsx scripts/build-ar-dictionaries.ts",
    "build:ar-dicts:players": "tsx scripts/build-ar-dictionaries.ts --players"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.0",
    "@payloadcms/next": "3.84.0",
    "@payloadcms/richtext-lexical": "3.84.0",
    "@payloadcms/storage-vercel-blob": "^3.84.0",
    "@payloadcms/ui": "3.84.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.49.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "payload": "3.84.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.12.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^8 || ^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": ">=3.4.0",
      "esbuild": ">=0.25.0",
      "vite": ">=6.4.2",
      "uuid": ">=14.0.0"
    }
  }
}
